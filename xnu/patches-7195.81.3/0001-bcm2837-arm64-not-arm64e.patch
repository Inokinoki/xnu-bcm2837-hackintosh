diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 5c5ef1a..b6d8d62 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -256,6 +256,12 @@ endif
 endif
 endif
 
+#
+# BCM2837 (Raspberry Pi 3) is ARMv8.0 with no pointer authentication: build plain arm64.
+ifeq ($(CURRENT_MACHINE_CONFIG),BCM2837)
+export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64
+endif
+
 #
 # This can have false negatives, and is used to avoid calling CTF when we'll build a static KC
 #
@@ -727,6 +733,8 @@ LDFLAGS_KERNEL_ONLY_SUBARCH_arm64e = \
 	-Wl,-add_split_seg_info \
 	-Wl,-kernel
 
+LDFLAGS_KERNEL_ONLY_SUBARCH_arm64 = $(LDFLAGS_KERNEL_ONLY_SUBARCH_arm64e)
+
 LDFLAGS_KERNEL_ONLY_SUBARCH_x86_64 = \
 	-Wl,-add_split_seg_info \
 	-Wl,-kernel

+/*
+ * Input source for the QEMU raspi3b, which has no touch screen: text commands on the PL011 serial
+ * port (uart0, QEMU serial0; tools/qemu-touch.py talks to it). One command per line:
+ *   t FINGER d|m|u X Y     touch down / move / up at panel pixel X,Y
+ *   k KEY d|u              key down/up: 0 power, 1 volume up, 2 volume down, 3 home
+ * Polled every 2 ms (the kernel has no interrupt controller driver yet).
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define PL011_PHYS      0x3f201000ULL
+#define PL011_DR        0x00
+#define PL011_FR        0x18
+#define PL011_LCRH      0x2c
+#define PL011_CR        0x30
+#define PL011_FR_RXFE   (1u << 4)
+
+class BCM2837HIDUart : public IOService {
+	OSDeclareDefaultStructors(BCM2837HIDUart);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+private:
+	static void pollFired(OSObject *owner, IOTimerEventSource *sender);
+	void command(char *line);
+	IOWorkLoop         *fWorkLoop;
+	IOTimerEventSource *fPoll;
+	vm_offset_t         fRegs;
+	char                fLine[96];
+	unsigned            fLen;
+	unsigned            fLogged;
+};
+OSDefineMetaClassAndStructors(BCM2837HIDUart, IOService);
+
+bool
+BCM2837HIDUart::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fRegs = ml_io_map((vm_offset_t)PL011_PHYS, 0x1000);
+	if (!fRegs) {
+		return false;
+	}
+	volatile uint32_t *r = (volatile uint32_t *)fRegs;
+	r[PL011_LCRH / 4] = 0x70;       /* 8N1, FIFOs on */
+	r[PL011_CR / 4] = 0x0301;       /* UART, TX, RX enabled */
+	fWorkLoop = IOWorkLoop::workLoop();
+	fPoll = IOTimerEventSource::timerEventSource(this, &BCM2837HIDUart::pollFired);
+	if (!fWorkLoop || !fPoll || fWorkLoop->addEventSource(fPoll) != kIOReturnSuccess) {
+		return false;
+	}
+	fPoll->setTimeoutMS(2);
+	registerService();
+	IOLog("BCM2837 HID: input commands on the PL011 UART\n");
+	return true;
+}
+
+void
+BCM2837HIDUart::command(char *line)
+{
+	char *tok[6];
+	int n = 0;
+
+	for (char *p = line; *p && n < 6;) {
+		while (*p == ' ') {
+			*p++ = 0;
+		}
+		if (*p) {
+			tok[n++] = p;
+			while (*p && *p != ' ') {
+				p++;
+			}
+		}
+	}
+	if (fLogged < 40) {
+		fLogged++;
+		IOLog("BCM2837 HID: command '%s'%s\n", n ? tok[0] : "", n > 1 ? " ..." : "");
+	}
+	if (n >= 5 && tok[0][0] == 't') {
+		int finger = (int)strtoul(tok[1], NULL, 10);
+		char state = tok[2][0];
+		int x = (int)strtoul(tok[3], NULL, 10), y = (int)strtoul(tok[4], NULL, 10);
+		bcm2837_hid_touch(finger, state != 'u', x, y);
+	} else if (n >= 3 && tok[0][0] == 'k') {
+		bcm2837_hid_key((int)strtoul(tok[1], NULL, 10), tok[2][0] == 'd');
+	}
+}
+
+void
+BCM2837HIDUart::pollFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	BCM2837HIDUart *self = (BCM2837HIDUart *)owner;
+	volatile uint32_t *r = (volatile uint32_t *)self->fRegs;
+
+	for (int i = 0; i < 256 && !(r[PL011_FR / 4] & PL011_FR_RXFE); i++) {
+		char c = (char)(r[PL011_DR / 4] & 0xff);
+		if (c == '\n' || c == '\r') {
+			if (self->fLen) {
+				self->fLine[self->fLen] = 0;
+				self->command(self->fLine);
+				self->fLen = 0;
+			}
+		} else if (self->fLen < sizeof(self->fLine) - 1) {
+			self->fLine[self->fLen++] = c;
+		}
+	}
+	sender->setTimeoutMS(2);
+}
diff --git a/iokit/Kernel/arm/hid/IOHIDEventService.h b/iokit/Kernel/arm/hid/IOHIDEventService.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/hid/IOHIDEventService.h
@@ -0,0 +1,75 @@
+/*
+ * BCM2837: minimal IOHIDEventService.
+ *
+ * Apple's IOHIDFamily kext is not part of xnu. The iOS 16.7 userland
+ * (IOKit.framework's HID event system, IOHIDFamily-1915.140.3) talks to
+ * IOHIDEventService objects through IOHIDEventServiceUserClient, which is
+ * compiled here unchanged from IOHIDFamily-1915.140.3 together with
+ * IOHIDEventServiceQueue and IOHIDEvent (the shared-memory event queue and
+ * the event serialization). This class provides only the part of the real
+ * IOHIDEventService interface that the user client uses, plus dispatchEvent
+ * for drivers. It does not parse HID report descriptors: subclasses build
+ * IOHIDEvents themselves.
+ */
+#ifndef _IOKIT_HID_IOHIDEVENTSERVICE_H
+#define _IOKIT_HID_IOHIDEVENTSERVICE_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOCommandGate.h>
+#include "IOHIDEventTypes.h"
+
+class IOHIDEvent;
+
+/* dispatchEvent options (IOHIDFamily IOHIDEventService.h) */
+enum {
+	kHIDDispatchOptionDeliveryNotificationForce         = (1 << 12),
+	kHIDDispatchOptionDeliveryNotificationSuppress      = (1 << 13)
+};
+
+class IOHIDEventService : public IOService
+{
+	OSDeclareDefaultStructors(IOHIDEventService);
+
+public:
+	typedef void (*Action)(OSObject *target, OSObject *sender, void *context, OSObject *event, IOOptionBits options);
+
+	virtual bool            start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual void            free(void) APPLE_KEXT_OVERRIDE;
+
+	virtual bool            open(IOService *client, IOOptionBits options, void *context, Action action);
+	virtual void            close(IOService *forClient, IOOptionBits options = 0) APPLE_KEXT_OVERRIDE;
+
+	virtual IOHIDEvent *    copyEvent(IOHIDEventType type, IOHIDEvent *matching = 0, IOOptionBits options = 0);
+	virtual IOHIDEvent *    copyMatchingEvent(OSDictionary *matching);
+	virtual IOReturn        setElementValue(UInt32 usagePage, UInt32 usage, UInt32 value);
+	virtual IOReturn        setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+
+	virtual UInt32          getPrimaryUsagePage();
+	virtual UInt32          getPrimaryUsage();
+
+	virtual IOReturn        newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+
+protected:
+	virtual bool            handleOpen(IOService *client, IOOptionBits options, void *argument) APPLE_KEXT_OVERRIDE;
+	virtual void            handleClose(IOService *client, IOOptionBits options) APPLE_KEXT_OVERRIDE;
+	virtual bool            handleIsOpen(const IOService *client) const APPLE_KEXT_OVERRIDE;
+
+	bool                    handleIsOpenLocked(const IOService *client) const;
+	virtual void            dispatchEvent(IOHIDEvent *event, IOOptionBits options = 0);
+
+	/* Published as HID properties by start(). */
+	virtual OSString *      getTransport();
+	virtual OSString *      getProduct();
+	virtual UInt32          getVendorID();
+	virtual UInt32          getProductID();
+	virtual UInt32          getReportInterval();
+
+	IOWorkLoop *            _hidWorkLoop;
+	IOCommandGate *         _hidGate;
+	IOLock *                _clientLock;
+	OSArray *               _clients;	/* IOHIDEventServiceClient per open client */
+};
+
+#endif /* _IOKIT_HID_IOHIDEVENTSERVICE_H */
diff --git a/iokit/Kernel/arm/hid/IOGraphicsTypes.h b/iokit/Kernel/arm/hid/IOGraphicsTypes.h
new file mode 100644

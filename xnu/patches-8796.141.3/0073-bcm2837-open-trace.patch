--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -4830,6 +4830,42 @@
  * gets called in vn_open_auth for open1. So we'll just do here what
  * nameiat() does.
  */
+#if defined(ARM64_BOARD_CONFIG_BCM2837)
+/*
+ * Trace: opens of the LaunchServices / PlugInKit / chronod stores and what they return (no LaunchServices store
+ * shows up on disk, so find out whether lsd cannot create it).
+ */
+static void
+sweet_open_trace(struct nameidata *ndp, int uflags, int error)
+{
+	static int count;
+	char buf[192];
+	size_t len = 0;
+
+	if (count >= 1500) {
+		return;
+	}
+	if (UIO_SEG_IS_USER_SPACE(ndp->ni_segflg)) {
+		if (copyinstr(ndp->ni_dirp, buf, sizeof(buf), &len) != 0) {
+			return;
+		}
+	} else {
+		strlcpy(buf, (const char *)(uintptr_t)ndp->ni_dirp, sizeof(buf));
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	/* everything chronod and pkd (the PlugInKit daemon) open, plus the store paths for the others */
+	bool watched = strcmp(name, "chronod") == 0 || strcmp(name, "pkd") == 0;
+	if (!watched && strnstr(buf, "csstore", sizeof(buf)) == NULL && strnstr(buf, "LaunchServices", sizeof(buf)) == NULL &&
+	    strnstr(buf, "luginKit", sizeof(buf)) == NULL && strnstr(buf, "chrono", sizeof(buf)) == NULL &&
+	    strnstr(buf, ".appex", sizeof(buf)) == NULL) {
+		return;
+	}
+	count++;
+	printf("SWEET open %s flags 0x%x err %d: %s\n", name, uflags, error, buf);
+}
+#endif /* BCM2837 */
+
 static int
 open1at(vfs_context_t ctx, struct nameidata *ndp, int uflags,
     struct vnode_attr *vap, fp_initfn_t fp_init, void *initarg, int32_t *retval,
@@ -4867,11 +4903,22 @@
 			error = open1(ctx, ndp, uflags, vap, fp_init, initarg,
 			    retval, authfd);
 			vnode_put(dvp_at);
+#if defined(ARM64_BOARD_CONFIG_BCM2837)
+			sweet_open_trace(ndp, uflags, error);
+#endif
 			return error;
 		}
 	}
 
+#if defined(ARM64_BOARD_CONFIG_BCM2837)
+	{
+		int err = open1(ctx, ndp, uflags, vap, fp_init, initarg, retval, authfd);
+		sweet_open_trace(ndp, uflags, err);
+		return err;
+	}
+#else
 	return open1(ctx, ndp, uflags, vap, fp_init, initarg, retval, authfd);
+#endif
 }
 

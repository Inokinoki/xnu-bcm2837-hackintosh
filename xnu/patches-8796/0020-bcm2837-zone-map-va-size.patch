index 182b44a..1c1e0dd 100644
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -160,7 +160,12 @@ ZONE_DEFINE_TYPE(percpu_u64_zone, "percpu.64", uint64_t,

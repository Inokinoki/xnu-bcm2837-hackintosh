+ */
+#ifndef _ARM64_PPL_UAT_H_
+#define _ARM64_PPL_UAT_H_
+
+static inline void
+uat_bootstrap(void)
+{
+}
+
+#endif /* _ARM64_PPL_UAT_H_ */
diff --git a/osfmk/arm64/tunables/tunables.s b/osfmk/arm64/tunables/tunables.s
new file mode 100644
index 0000000..12e9af3
--- /dev/null
+++ b/osfmk/arm64/tunables/tunables.s
@@ -0,0 +1,7 @@
+/*
+ * BCM2837: Apple's per-SoC CPU tunables (implementation-defined HID/ACC
+ * register settings applied in start.s) are not in the open source drop,
+ * and none of them exist on the Cortex-A53. APPLY_TUNABLES does nothing.
+ */
+.macro APPLY_TUNABLES midr, tmp1, tmp2
+.endmacro

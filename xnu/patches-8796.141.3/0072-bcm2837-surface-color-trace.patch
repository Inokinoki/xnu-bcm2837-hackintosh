 static uint64_t sweet_surf_logged;      /* selectors / traps already logged (< 64) */
 
+/*
+ * Trace: per-channel statistics of the pixels a client just wrote (every 64th pixel in each direction), for
+ * the first unlocks: what do the intermediate surfaces (luminance+alpha masks, BGRA layers) hold?
+ */
+static uint32_t sweet_surf_trace_count;
+
+static void
+sweet_surface_trace_unlock(SweetSurface *s)
+{
+	if (sweet_surf_trace_count >= 400 || (s->bytesPerElement != 2 && s->bytesPerElement != 4) ||
+	    s->planeCount != 0 || s->width == 0 || s->height == 0) {
+		return;
+	}
+	uint64_t need = (uint64_t)s->offset + (uint64_t)(s->height - 1) * s->bytesPerRow +
+	    (uint64_t)s->width * s->bytesPerElement;
+	if (s->memory == NULL || need > s->memory->getLength()) {
+		return;
+	}
+	uintptr_t base = s->kernelAddress();
+	if (base == 0) {
+		return;
+	}
+	sweet_surf_trace_count++;
+	const uint8_t *p = (const uint8_t *)(base + s->offset);
+	uint32_t bpe = s->bytesPerElement;
+	uint32_t ystep = s->height > 64 ? s->height / 64 : 1, xstep = s->width > 64 ? s->width / 64 : 1;
+	uint64_t sum[4] = { 0, 0, 0, 0 }, nz[4] = { 0, 0, 0, 0 }, n = 0;
+	uint32_t mx[4] = { 0, 0, 0, 0 };
+	for (uint32_t y = 0; y < s->height; y += ystep) {
+		for (uint32_t x = 0; x < s->width; x += xstep) {
+			const uint8_t *px = p + (uint64_t)y * s->bytesPerRow + (uint64_t)x * bpe;
+			for (uint32_t c = 0; c < bpe; c++) {
+				sum[c] += px[c];
+				nz[c] += px[c] != 0;
+				mx[c] = px[c] > mx[c] ? px[c] : mx[c];
+			}
+			n++;
+		}
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("BCM2837 SURF: unlock %s id %u %ux%u fmt 0x%x bpe %u n %llu mean %llu %llu %llu %llu nz %llu %llu %llu %llu max %u %u %u %u\n",
+	    name, s->id, s->width, s->height, s->pixelFormat, bpe, n,
+	    sum[0] / (n ? n : 1), sum[1] / (n ? n : 1), sum[2] / (n ? n : 1), sum[3] / (n ? n : 1),
+	    nz[0], nz[1], nz[2], nz[3], mx[0], mx[1], mx[2], mx[3]);
+}
+

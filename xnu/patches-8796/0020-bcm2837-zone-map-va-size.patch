-#if XNU_PLATFORM_MacOSX
+/*
+ * BCM2837 is built as a macOS platform but only has a 112 GiB kernel VA window
+ * (39-bit, 4K pages): the 128 GiB macOS zone range cannot fit, kmem_range_init()
+ * panics. Use the embedded sizes.
+ */
+#if XNU_PLATFORM_MacOSX && !defined(ARM64_BOARD_CONFIG_BCM2837)
 #define ZONE_MAP_MAX            (32ULL << 30)
 #define ZONE_MAP_VA_SIZE        (128ULL << 30)
 #else /* XNU_PLATFORM_MacOSX */

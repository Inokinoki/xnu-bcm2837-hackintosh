--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -338,6 +338,17 @@
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
 
+# BCM2837 (Raspberry Pi 3, 1 GiB, 4K pages) uses the standard non-large-memory
+# layout: the kernel links above LOW_GLOBAL_BASE_ADDRESS (0xfffffff000000000),
+# the base the VM pointer packing and the kmem ranges use. ARM_LARGE_MEMORY
+# (set for every MacOSX target) would link at 0xfffffe0007004000, outside the
+# 39-bit window of the 4K T1SZ_BOOT.
+ifeq ($(CURRENT_MACHINE_CONFIG),BCM2837)
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+ARM64_PLKSEG_ADDR  =0xfffffff004004000
+ARM64_LINK_ADDR    =0xfffffff007004000
+endif
+
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
 			$(LARGE_MEMORY_DEFINE) -momit-leaf-frame-pointer -fno-strict-aliasing -D__API__=v4 -mkernel

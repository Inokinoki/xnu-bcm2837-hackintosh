--- a/osfmk/ipc/ipc_kmsg.c
+++ b/osfmk/ipc/ipc_kmsg.c
@@ -2910,6 +2910,56 @@
 
 	port = hdr->msgh_remote_port;
 	assert(IP_VALID(port));
+#if defined(ARM64_BOARD_CONFIG_BCM2837)
+	/*
+	 * Trace: mach messages sent by lsd (XPC requests to pkd, containermanagerd, ...): destination, size and the
+	 * printable text at the start of the body (XPC dictionary keys), to see what lsd asks for when it drops plug-ins.
+	 */
+	{
+		static int mcount;
+		char sname[32] = "";
+		if (get_bsdtask_info(current_task())) {
+			strlcpy(sname, proc_name_address(get_bsdtask_info(current_task())), sizeof(sname));
+		}
+		if (mcount < 20000 && strcmp(sname, "lsd") == 0) {
+			char dname[32] = "?", text[120];
+			uint32_t n = 0, sz = hdr->msgh_size, i;
+			const uint8_t *body = (const uint8_t *)(hdr + 1);
+			ip_mq_lock(port);
+			if (ip_active(port) && ip_in_a_space(port) && !ip_in_space(port, ipc_space_kernel)) {
+				ipc_space_t dspace = ip_get_receiver(port);
+				if (dspace && is_active(dspace) && get_bsdtask_info(dspace->is_task)) {
+					strlcpy(dname, proc_name_address(get_bsdtask_info(dspace->is_task)), sizeof(dname));
+				}
+			}
+			ip_mq_unlock(port);
+			/* skip the chatty destinations (launchd, logd, notifyd, ...): keep pkd, the managers and unresolved ports */
+			if (strcmp(dname, "pkd") != 0 && strcmp(dname, "?") != 0 && strncmp(dname, "containermanag", 14) != 0 &&
+			    strcmp(dname, "usermanagerd") != 0) {
+				goto sweet_msg_done;
+			}
+			for (i = 0; kmsg->ikm_type == IKM_TYPE_ALL_INLINED && sz > sizeof(*hdr) && i < sz - sizeof(*hdr) && i < 400 && n < sizeof(text) - 1; i++) {
+				uint8_t c = body[i];
+				if (c >= 0x20 && c < 0x7f) {
+					text[n++] = (char)c;
+				} else if (n && text[n - 1] != '.') {
+					text[n++] = '.';
+				}
+			}
+			text[n] = 0;
+			char hex[97];
+			for (i = 0; kmsg->ikm_type == IKM_TYPE_ALL_INLINED && i < 48 && sz > sizeof(*hdr) && i < sz - sizeof(*hdr); i++) {
+				hex[i * 2] = "0123456789abcdef"[body[i] >> 4];
+				hex[i * 2 + 1] = "0123456789abcdef"[body[i] & 15];
+			}
+			hex[i * 2] = 0;
+			mcount++;
+			printf("SWEET lsd msg to %s id 0x%x size %u: %s | %s\n", dname, hdr->msgh_id, sz, hex, text);
+		}
+sweet_msg_done:
+		;
+	}
+#endif /* BCM2837 */
 	ip_mq_lock(port);
 
 	/*

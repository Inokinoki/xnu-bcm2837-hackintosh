-/* Copy each enabled layer's surface into the panel memory (no scaling). */
+/*
+ * A swap only records the frame: copying a whole frame into the panel on every swap (backboardd
+ * presents at 60 Hz) would take the whole CPU. The vsync timer shows the latest frame every
+ * fFlushTicks ticks (boot-arg sweetfb_hz, default 10 Hz).
+ */
 void
 AppleCLCD::swap(const uint8_t *rec)
 {
+	IOLockLock(fLock);
+	memcpy(fPending, rec, BCM2837_FB_SWAP_REC_SIZE);
+	fDirty = true;
+	IOLockUnlock(fLock);
+}

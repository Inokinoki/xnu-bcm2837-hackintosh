--- /dev/null
+++ b/iokit/Kernel/arm/BCM2837PlatformExpert.cpp
@@ -0,0 +1,86 @@
+/*
+ * Minimal device-tree platform expert for the Raspberry Pi 3 (BCM2837).
+ * Uses XNU's normal platform, power-domain and nub initialization. Hardware
+ * interrupt and power-management services are supplied by separate drivers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_BCM2837)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class BCM2837PlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(BCM2837PlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	bool getTargetName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+	bool getProductName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(BCM2837PlatformExpert, IODTPlatformExpert);
+
+bool
+BCM2837PlatformExpert::start(IOService *provider)
+{
+	IOLog("BCM2837: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("BCM2837: platform expert registered\n");
+	return true;
+}
+
+const char *
+BCM2837PlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+BCM2837PlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+BCM2837PlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The stock implementation requires an Apple NVRAM /options node. The Pi
+	 * has no NVRAM controller; publish the CPU and device nodes without
+	 * inventing one.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+}
+
+bool
+BCM2837PlatformExpert::getTargetName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "bcm2837", (size_t)maxLength);
+	return true;
+}
+
+bool
+BCM2837PlatformExpert::getProductName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "Raspberry Pi 3 Model B", (size_t)maxLength);
+	return true;
+}
+#endif /* ARM64_BOARD_CONFIG_BCM2837 */
